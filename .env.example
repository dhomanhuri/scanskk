# Host port docker-compose exposes on 127.0.0.1 (proxied by the cloudflared tunnel).
APP_PORT=3021

# --- Symposium upstream (server-side only; never exposed to the browser) ---
SYMPOSIUM_BASE_URL=https://simposiumtihulumigas2026.com
SYMPOSIUM_USERNAME=
SYMPOSIUM_PASSWORD=

# Login form. Defaults suit a stock Yii2 LoginForm; adjust if the booth
# account uses different field names or a different path.
SYMPOSIUM_LOGIN_PATH=/kitchen/default/login
SYMPOSIUM_LOGIN_FIELD_USER=User[username]
SYMPOSIUM_LOGIN_FIELD_PASS=User[password]

# Scan endpoint hit after a QR is read.
SYMPOSIUM_SCAN_PATH=/kitchen/dson/scanbooth
